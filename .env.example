# ===========================================
# Gachena - Environment Configuration
# Copy this file to .env and fill in your values
# ===========================================

# --- Required: Google OAuth ---
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8501/

# --- Required: External API Keys ---
FIRECRAWL_API_KEY=your_firecrawl_api_key
LOGODEV_API_KEY=your_logodev_api_key

# --- Required: Vertex AI / Gemini ---
SERVICE_ACCOUNT_PATH=service_acc.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# --- Optional: Session & Security ---
# IMPORTANT: Change this to a strong random string in production!
COOKIE_KEY=change_me_to_a_random_secret_string
COOKIE_NAME=gachena_auth
COOKIE_EXPIRY_DAYS=30

# --- Optional: AI Behavior ---
GEMINI_MODEL=gemini-1.5-flash-001
MAX_GEMINI_RETRIES=3
GEMINI_RETRY_DELAY=60

# --- Optional: App Behavior ---
LOGO_TIMEOUT=5
MAX_EMAILS_SCAN=1000
DEFAULT_DATE_RANGE=7